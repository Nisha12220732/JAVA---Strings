import java.util.*;
class Main {
    public static void main(String[] args) {
    Scanner sc = new Scanner(System.in);
    String s = sc.next();
    int n = sc.nextInt();
    String[] str = new String[n];
    for(int i =0;i<n;i++){
        str[i] = sc.next();
    }
    int[] ans = new int[n];
    
    for(int i = 0;i<n;i++){
        int count = 0;
        if(str[i].equals(s)){
            count = 0;
        }
        else{
            int l1 = str[i].length() -1;
            int l2 = s.length() -1;
            while(str[i].charAt(l1) == s.charAt(l2)){
                l1--;
                l2--;
                count++;
            }
        }
        ans[i] = count;
    }
    for(int i =0;i<n;i++){
        System.out.println(ans[i]);
    }
    int ansind = 0;
    for(int i =0;i<n;i++){
        if(ans[i] > ans[ansind]){
            ansind = i;
        }
    }
    System.out.println(str[ansind]);
    }
}
